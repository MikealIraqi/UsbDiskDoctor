<Window x:Class="UsbDiskDoctor.App.Views.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="للتواصل"
        Width="500"
        Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="📞" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="للتواصل" Style="{StaticResource TextH1}" HorizontalAlignment="Center"/>
                <TextBlock Text="UsbDiskDoctor v1.3.1" Style="{StaticResource TextTiny}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,24"/>

            <!-- Programmer -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="المبرمج:" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="محمود العبوده" Style="{StaticResource TextBody}" FontWeight="SemiBold" FontSize="15"/>
            </Grid>

            <!-- WhatsApp -->
            <Grid Grid.Row="3" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="واتساب / اتصال:" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="009647730393399" Style="{StaticResource TextBody}"
                           FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="فتح واتساب"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,6"
                        Click="OnWhatsAppClicked"/>
            </Grid>

            <!-- Email -->
            <Grid Grid.Row="4" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="البريد الإلكتروني:" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="tearscantstop@gmail.com" Style="{StaticResource TextBody}"
                           FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="إرسال بريد"
                        Style="{StaticResource PrimaryButton}"
                        Padding="12,6"
                        Click="OnEmailClicked"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="نسخ رقم الهاتف"
                        Style="{StaticResource SecondaryButton}"
                        Padding="14,8"
                        Margin="0,0,8,0"
                        Click="OnCopyPhoneClicked"/>
                <Button Content="إغلاق"
                        Style="{StaticResource GhostButton}"
                        Padding="14,8"
                        Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
