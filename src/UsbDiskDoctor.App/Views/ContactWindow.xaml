<Window x:Class="UsbDiskDoctor.App.Views.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="للتواصل"
        Width="520"
        Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16"
            Padding="32,28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="📞" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="للتواصل" Style="{StaticResource TextH1}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="UsbDiskDoctor v1.3.1" Style="{StaticResource TextTiny}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

            <Border Grid.Row="3" Height="1" Background="{StaticResource BorderBrush}" Margin="0,20,0,20"/>

            <Border Grid.Row="4" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="👤" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="المبرمج" Style="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="محمود العبوده" Style="{StaticResource TextBody}" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="5" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📱" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="واتساب / اتصال" Style="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="009647730393399" Style="{StaticResource TextBody}" FontFamily="{StaticResource MonoFontFamily}" FontSize="14" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="فتح واتساب" Style="{StaticResource PrimaryButton}" Padding="14,8" VerticalAlignment="Center" Click="OnWhatsAppClicked"/>
                </Grid>
            </Border>

            <Border Grid.Row="6" Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="📧" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="البريد الإلكتروني" Style="{StaticResource TextMuted}" FontSize="11"/>
                        <TextBlock Text="tearscantstop@gmail.com" Style="{StaticResource TextBody}" FontFamily="{StaticResource MonoFontFamily}" FontSize="13" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="إرسال بريد" Style="{StaticResource PrimaryButton}" Padding="14,8" VerticalAlignment="Center" Click="OnEmailClicked"/>
                </Grid>
            </Border>

                                                                                                <StackPanel Grid.Row="7"                                                             Orientation="Horizontal"                                                             HorizontalAlignment="Center"                                                             VerticalAlignment="Bottom"                                                             Margin="0,0,0,16"                                                             FlowDirection="RightToLeft">                                                     <TextBlock Text="صُنع بـ"                                                                Style="{StaticResource TextMuted}"                                                                FontSize="12"                                                                VerticalAlignment="Center"/>                                                     <Path Fill="#EF4444"                                                           Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5 2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"                                                           Width="14" Height="14"                                                           Stretch="Uniform"                                                           VerticalAlignment="Center"                                                           Margin="5,0,5,0"/>                                                     <TextBlock Text="في العراق"                                                                Style="{StaticResource TextMuted}"                                                                FontSize="12"                                                                VerticalAlignment="Center"/>                                                 </StackPanel>
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="📋 نسخ رقم الهاتف" Style="{StaticResource SecondaryButton}" Padding="16,10" Margin="0,0,10,0" Click="OnCopyPhoneClicked"/>
                <Button Content="إغلاق" Style="{StaticResource GhostButton}" Padding="20,10" Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
