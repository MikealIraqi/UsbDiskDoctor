<Window x:Class="UsbDiskDoctor.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="حول البرنامج"
        Width="620"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}"
        FlowDirection="RightToLeft"
        ShowInTaskbar="False">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16"
            Padding="32,28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🩺" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="حول البرنامج" Style="{StaticResource TextH1}" HorizontalAlignment="Center"/>
                <TextBlock Text="UsbDiskDoctor v1.3.1" Style="{StaticResource TextTiny}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" TextAlignment="Justify">
                        أداة عراقية تعمل على Windows، تفحص وتشخّص وتُصلح وحدات التخزين الخارجية (فلاشات USB، هاردات، SD) — بدون إنترنت، بالعربية، وبواجهة حديثة.
                    </TextBlock>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="1. يكتشف ويفحص الأجهزة" Style="{StaticResource TextH3}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Justify">
                                يكتشف أجهزتك تلقائياً ويعرض تفاصيلها الكاملة (الاسم، الحجم، الرقم التسلسلي، الحالة). ثم يقرأ بيانات S.M.A.R.T.، ويفحص نظام الملفات، ويعطيك تقييم واضح: سليم ✅ / تحذير ⚠️ / حرج 🔴.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="2. يكشف الفلاشات المزيفة" Style="{StaticResource TextH3}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Justify">
                                الميزة الأقوى — كثير فلاشات تعلن 128 GB وهي فعلياً 8 GB. البرنامج يكتب أنماط اختبار على كامل السعة، يقرأها، ويكتشف أي wraparound — ثم يعطيك السعة الحقيقية بدقة.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🛡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="3. يستعيد الملفات ويقترح إصلاحات آمنة" Style="{StaticResource TextH3}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Justify">
                                يسترجع ملفاتك المفقودة (صور JPEG/PNG، PDF) بتقنية File Carving — بدون الإضرار بالبيانات الأصلية. ثم يقدّم قائمة إصلاحات مصنّفة (آمن / متوسط / خطير)، وكل إجراء لازم يمر على نافذة تأكيد قبل التنفيذ.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,16"/>

                    <TextBlock Style="{StaticResource TextH3}" Margin="0,0,0,8" Text="مميزات إضافية"/>
                    <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• تقارير احترافية HTML (عربي RTL) + JSON"/>
                    <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6" Text="• قاعدة معرفة عربية (9 مقالات)"/>
                    <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16" Text="• أمان متعدد الطبقات — لا كتابة بدون إذن صريح"/>

                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="تطوير المبرمج : محمود العبوده" Style="{StaticResource TextBody}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="البصرة — العراق" Style="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="صُنع بـ" Style="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                    <Path Fill="#EF4444"
                          Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5 2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                          Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <TextBlock Text="في العراق" Style="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="إغلاق" Style="{StaticResource PrimaryButton}" Padding="24,10" HorizontalAlignment="Center" Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
