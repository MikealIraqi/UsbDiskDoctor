<Window x:Class="UsbDiskDoctor.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About.Title}"
        Width="640" Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="12"
            Margin="16" Padding="32,28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="🩺" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource About.Title}" Style="{StaticResource TextH1}" HorizontalAlignment="Center"/>
                <TextBlock Text="UsbDiskDoctor v1.4.0" Style="{StaticResource TextTiny}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource About.Intro}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource About.Feature1Title}" Style="{StaticResource TextH3}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource About.Feature1Body}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🎯" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource About.Feature2Title}" Style="{StaticResource TextH3}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource About.Feature2Body}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="🛡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource About.Feature3Title}" Style="{StaticResource TextH3}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource About.Feature3Body}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,4,0,16"/>

                    <TextBlock Text="{DynamicResource About.ExtrasTitle}" Style="{StaticResource TextH3}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource About.Extra1}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource About.Extra2}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource About.Extra3}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="10" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About.Developer}" Style="{StaticResource TextBody}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="{DynamicResource About.Location}" Style="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="{DynamicResource Contact.MadeIn}" Style="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                    <Path Fill="#EF4444" Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5 2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <TextBlock Text="{DynamicResource Contact.MadeInCountry}" Style="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="{DynamicResource Common.Close}" Style="{StaticResource PrimaryButton}" Padding="24,10" HorizontalAlignment="Center" Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>