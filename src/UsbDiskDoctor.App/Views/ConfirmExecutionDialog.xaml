<Window x:Class="UsbDiskDoctor.App.Views.ConfirmExecutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تأكيد تنفيذ الإجراء"
        Width="600"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">
    <Grid FlowDirection="RightToLeft" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="تأكيد تنفيذ الإجراء"
                       Style="{StaticResource TextH1}"
                       Margin="0,0,0,16"/>

            <Border Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="الإجراء:" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ActionCodeText}"
                               Style="{StaticResource TextMono}"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="الوصف:" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DescriptionText}"
                               Style="{StaticResource TextBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="مستوى الخطورة:" Style="{StaticResource TextLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding RiskLevelTextAr}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{Binding RiskForegroundHex}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding WarningTextAr}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{Binding WarningForegroundHex}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Command + Token -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="الأمر المقترح (للعرض فقط):"
                       Style="{StaticResource TextLabel}"
                       Margin="0,0,0,8"/>

            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,20">
                <TextBlock Text="{Binding CommandPreviewText}"
                           Style="{StaticResource TextMono}"
                           TextWrapping="Wrap"/>
            </Border>

            <StackPanel Visibility="{Binding RequiresToken, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="للتأكيد، اكتب الكلمة التالية:"
                           Style="{StaticResource TextLabel}"
                           Margin="0,0,0,8"/>

                <Border Background="{StaticResource DangerLightBrush}"
                        CornerRadius="8"
                        Padding="14,10"
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left">
                    <TextBlock Text="{Binding RequiredTokenText}"
                               Style="{StaticResource TextMono}"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="{StaticResource DangerBrush}"/>
                </Border>

                <TextBox Text="{Binding TokenInput, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="14"
                         Padding="10,8"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"
                         Background="{StaticResource SurfaceBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="إلغاء"
                    Style="{StaticResource GhostButton}"
                    Width="120"
                    Margin="0,0,12,0"
                    Click="OnCancelClicked"/>
            <Button Content="تنفيذ"
                    Style="{StaticResource PrimaryButton}"
                    Width="120"
                    IsEnabled="{Binding CanExecute}"
                    Click="OnExecuteClicked"/>
        </StackPanel>
    </Grid>
</Window>