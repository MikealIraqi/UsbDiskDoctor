<Window x:Class="UsbDiskDoctor.App.Views.ConfirmExecutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تأكيد تنفيذ الإجراء"
        Width="550"
        Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid FlowDirection="RightToLeft">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Action Information -->
        <StackPanel Grid.Row="0" Margin="20">
            <TextBlock Text="الإجراء:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding ActionCodeText}"
                       FontFamily="Consolas"
                       FontSize="14"
                       Margin="0,0,0,15"/>

            <TextBlock Text="الوصف:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding DescriptionText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <TextBlock Text="مستوى الخطورة:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding RiskLevelTextAr}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{Binding RiskForegroundHex}"
                       Margin="0,0,0,5"/>

            <TextBlock Text="{Binding WarningTextAr}"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{Binding WarningForegroundHex}"
                       Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Row 1: Command Preview and Token Input -->
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="الأمر المقترح (للعرض فقط):" FontWeight="Bold" Margin="0,0,0,5"/>
            <Border Background="#f3f4f6" Padding="8" Margin="0,0,0,15">
                <TextBlock Text="{Binding CommandPreviewText}"
                           FontFamily="Consolas"
                           TextWrapping="Wrap"/>
            </Border>

            <StackPanel Visibility="{Binding RequiresToken, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="للتأكيد، اكتب:" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding RequiredTokenText}"
                           FontFamily="Consolas"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#dc2626"
                           Margin="0,0,0,10"/>
                <TextBox Text="{Binding TokenInput, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas"
                         FontSize="14"
                         Padding="5"
                         Margin="0,0,0,10"/>
            </StackPanel>
        </StackPanel>

        <!-- Row 2: Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="20">
            <Button Content="تنفيذ"
                    Width="120"
                    Padding="10,5"
                    IsEnabled="{Binding CanExecute}"
                    Click="OnExecuteClicked"/>
            <Button Content="إلغاء"
                    Width="120"
                    Padding="10,5"
                    Margin="10,0,0,0"
                    Click="OnCancelClicked"/>
        </StackPanel>
    </Grid>
</Window>