<Window x:Class="UsbDiskDoctor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:recModels="clr-namespace:UsbDiskDoctor.Recovery.Models;assembly=UsbDiskDoctor.Recovery"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="UsbDiskDoctor — أداة فحص أقراص USB"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource PrimaryFontFamily}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- HEADER                                       -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡"
                               FontSize="22"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="UsbDiskDoctor"
                               Style="{StaticResource TextH2}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="v1.2.0"
                               Style="{StaticResource TextTiny}"
                               Margin="10,3,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status Message -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Style="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="20,0"/>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="خروج"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Click="OnExitClicked"
                            ToolTip="إغلاق التطبيق"/>
                    <Button AutomationProperties.Name="تشغيل الفحص الكامل للجهاز المحدد"
                            Content="فحص كامل"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RunFullDiagnosticCommand}"
                            Margin="0,0,8,0"/>
                    <Button AutomationProperties.Name="تحديث قائمة الأجهزة"
                            Content="تحديث"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- MAIN CONTENT (TABS)                          -->
        <!-- ═══════════════════════════════════════════ -->
        <TabControl Grid.Row="1"
                    KeyboardNavigation.TabNavigation="Once"
                    Margin="20"
                    Background="Transparent"
                    BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="tabBorder"
                                        Background="Transparent"
                                        CornerRadius="8"
                                        Padding="18,8"
                                        Margin="0,0,6,0">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background"
                                                Value="{StaticResource PrimaryLightBrush}"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground"
                                                Value="{StaticResource TextSecondaryBrush}"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="False"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="tabBorder" Property="Background"
                                                Value="{StaticResource SurfaceAltBrush}"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}"/>
                    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Style>
            </TabControl.Resources>

            <!-- ═════════ TAB 1: الأجهزة ═════════ -->
            <TabItem Header="الأجهزة">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,12,0,0">
                    <ListView AutomationProperties.Name="قائمة أجهزة USB المتصلة"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="8">
                        <ListView.Resources>
                            <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ModernColumnHeaderStyle}"/>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="itemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background"
                                                            Value="{StaticResource SurfaceAltBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background"
                                                            Value="{StaticResource PrimaryLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="اسم الجهاز" DisplayMemberBinding="{Binding FriendlyName}" Width="260"/>
                                <GridViewColumn Header="معرف الجهاز" DisplayMemberBinding="{Binding DeviceId}" Width="200"/>
                                <GridViewColumn Header="الحجم (بايت)" DisplayMemberBinding="{Binding SizeBytes}" Width="160"/>
                                <GridViewColumn Header="الحالة" DisplayMemberBinding="{Binding OperationalStatus}" Width="140"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </TabItem>

            <!-- ═════════ TAB 2: التفاصيل ═════════ -->
            <TabItem Header="التفاصيل">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  DataContext="{Binding DetailsViewModel}"
                                  Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding FriendlyName}"
                                       Style="{StaticResource TextH1}"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="معلومات عامة"
                                       Style="{StaticResource TextH3}"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="معرف الجهاز:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceIdText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="الموديل:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ModelText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="الرقم التسلسلي:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SerialNumberText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="نوع الناقل:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BusTypeText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="نوع الوسائط:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MediaTypeText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="نمط التقسيم:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PartitionStyleText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="الحجم:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="الحالة التشغيلية:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding OperationalStatusText}" Style="{StaticResource TextBody}" Margin="0,4"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="الحالة الصحية:" Style="{StaticResource TextLabel}" Margin="0,4"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding HealthStatusText}" Style="{StaticResource TextBody}" Margin="0,4"/>
                            </Grid>

                            <TextBlock Style="{StaticResource TextH3}" Margin="0,10,0,12">
                                <Run Text="الفوليومات ("/>
                                <Run Text="{Binding VolumesCountText, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <ListView ItemsSource="{Binding Volumes}"
                                      MinHeight="100"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="الحرف" DisplayMemberBinding="{Binding DriveLetter}" Width="60"/>
                                        <GridViewColumn Header="الاسم" DisplayMemberBinding="{Binding Label}" Width="150"/>
                                        <GridViewColumn Header="نظام الملفات" DisplayMemberBinding="{Binding FileSystem}" Width="120"/>
                                        <GridViewColumn Header="الحجم (بايت)" DisplayMemberBinding="{Binding SizeBytes}" Width="130"/>
                                        <GridViewColumn Header="متاح (بايت)" DisplayMemberBinding="{Binding FreeSpaceBytes}" Width="130"/>
                                        <GridViewColumn Header="مُثبّت" DisplayMemberBinding="{Binding IsMounted}" Width="80"/>
                                        <GridViewColumn Header="RAW" DisplayMemberBinding="{Binding IsRaw}" Width="70"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <TextBlock Style="{StaticResource TextH3}" Margin="0,24,0,12">
                                <Run Text="اقتراحات الإصلاح ("/>
                                <Run Text="{Binding ProposalsCount, Mode=OneWay}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <ListView ItemsSource="{Binding Proposals}"
                                      MinHeight="140"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="الإجراء" DisplayMemberBinding="{Binding ActionCode}" Width="240"/>
                                        <GridViewColumn Header="المستوى" DisplayMemberBinding="{Binding RiskLevel}" Width="100"/>
                                        <GridViewColumn Header="يحتاج تأكيد" DisplayMemberBinding="{Binding RequiresConfirmation}" Width="100"/>
                                        <GridViewColumn Header="الوصف" DisplayMemberBinding="{Binding DescriptionAr}" Width="300"/>
                                        <GridViewColumn Header="" Width="100">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="تنفيذ"
                                                            Style="{StaticResource PrimaryButton}"
                                                            Padding="12,4"
                                                            Command="{Binding DataContext.RequestExecuteProposalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        <!-- FAKE CAPACITY CHECK SECTION -->
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,24,0,0"
                                Visibility="{Binding HasCapacityCheck, Converter={StaticResource BoolToVis}}">
                            <StackPanel DataContext="{Binding CapacityCheck}">
                                <!-- Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🔍" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="فحص السعة الحقيقية" Style="{StaticResource TextH3}"/>
                                </StackPanel>
                                <TextBlock Text="يكتب أنماط اختبار على القرص ثم يقرأها للتحقق من السعة الحقيقية. يكشف الفلاشات المزيفة التي تعلن سعة أكبر مما فيها."
                                           Style="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <!-- Controls row -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="الوضع:" Style="{StaticResource TextLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox AutomationProperties.Name="وضع فحص السعة الحقيقية"
                                                  SelectedValue="{Binding SelectedMode, Mode=TwoWay}"
                                                  SelectedValuePath="Tag"
                                                  MinWidth="140"
                                                  FontFamily="{StaticResource PrimaryFontFamily}"
                                                  FontSize="13"
                                                  Padding="10,6">
                                            <ComboBoxItem Content="سريع" Tag="{x:Static recModels:CapacityCheckMode.Quick}"/>
                                            <ComboBoxItem Content="ذكي (افتراضي)" Tag="{x:Static recModels:CapacityCheckMode.Smart}"/>
                                            <ComboBoxItem Content="كامل" Tag="{x:Static recModels:CapacityCheckMode.Full}"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1"
                                              Content="السماح بالكتابة على وحدة غير فارغة"
                                              IsChecked="{Binding AllowWriteOnNonEmpty, Mode=TwoWay}"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              FontFamily="{StaticResource PrimaryFontFamily}"
                                              FontSize="12"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="20,0"/>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button AutomationProperties.Name="إلغاء فحص السعة الجاري"
                                                Content="إلغاء"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding CancelCheckCommand}"
                                                Padding="14,8"
                                                Margin="0,0,8,0"/>
                                        <Button AutomationProperties.Name="بدء فحص السعة الحقيقية للقرص"
                                                Content="▶ بدء الفحص"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding StartCheckCommand}"
                                                Padding="14,8"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Progress card (visible while running) -->
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CurrentPhaseText}" Style="{StaticResource TextBody}" FontWeight="Medium"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PercentComplete, StringFormat={}{0:F1}%}" Style="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </Grid>

                                        <ProgressBar AutomationProperties.Name="نسبة تقدم فحص السعة"
                                                     Value="{Binding PercentComplete}"
                                                     Minimum="0" Maximum="100"
                                                     Height="8"
                                                     Margin="0,8,0,12"
                                                     Background="{StaticResource SurfaceAltBrush}"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     BorderThickness="0"/>

                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚡" Style="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,16,0"/>
                                            <TextBlock Text="⏱" Style="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource TextSecondary}" FontWeight="Medium" Margin="0,0,16,0"/>
                                            <TextBlock Text="⏳" Style="{StaticResource TextSecondary}" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding EtaText}" Style="{StaticResource TextSecondary}" FontWeight="Medium"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Result card (visible when HasResult) -->
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding VerdictColorHex, Converter={StaticResource HexToBrush}}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding VerdictText}"
                                                       Style="{StaticResource TextH3}"
                                                       Foreground="{Binding VerdictColorHex, Converter={StaticResource HexToBrush}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DiagnosticMessage}"
                                                   Style="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- ═════════ TAB 3: التقرير ═════════ -->
            <TabItem Header="التقرير">
                <Border Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Margin="0,12,0,0"
                        Padding="1">
                    <Grid>
                        <wv2:WebView2 x:Name="ReportWebView"/>
                        <TextBlock Text="لا يوجد تقرير بعد. اختر جهازاً واضغط «فحص كامل»."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="16"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   x:Name="ReportEmptyHint"/>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════════════════════════ -->
        <!-- STATUS BAR                                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status dot + text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="Ready"
                               Style="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Devices count -->
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           Style="{StaticResource TextSecondary}"
                           VerticalAlignment="Center">
                    <Run Text="عدد الأجهزة: "/>
                    <Run Text="{Binding Devices.Count, Mode=OneWay}" FontWeight="SemiBold"/>
                </TextBlock>

                <!-- Version -->
                <TextBlock Grid.Column="2"
                           Text="v1.2.0"
                           Style="{StaticResource TextTiny}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>