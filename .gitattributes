# Normalize line endings
* text=auto eol=lf

# Windows-specific files
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary

# JSON
*.json text eol=lf

# Visual Studio files
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf

# Documentation
*.md text eol=lf